# Database Configuration (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/curakid
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=redis_password

# Apache Kafka Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=curakid-notification-group

# Mail Configuration (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password_here

# Google AI & OAuth
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# JWT Configuration (at least 32 characters)
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long_here
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Internal Security (shared between Spring Boot and Python FIS)
INTERNAL_API_KEY=your_internal_api_key_secret_here

# FIS Microservice
FIS_BASE_URL=http://localhost:8000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Sentry Monitoring & Error Tracking (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Firebase Admin SDK Configuration (Optional)
FIREBASE_CREDENTIALS_PATH=
